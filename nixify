#!/usr/bin/env bash
# Refresh npmDepsHash in default.nix after package-lock.json changes.
set -eu

hash=$(nix-shell -p prefetch-npm-deps --run 'prefetch-npm-deps package-lock.json')
sed -i.bak "s|npmDepsHash = \".*\";|npmDepsHash = \"$hash\";|" default.nix
rm -f default.nix.bak
echo "npmDepsHash = $hash"

nix-build
